{
    "extends": "@vue/tsconfig/tsconfig.json",
    "compilerOptions": {
        "ignoreDeprecations": "5.0",
        "allowJs": true,
        "checkJs": false,
        "sourceMap": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["esnext", "dom"],
        "types": ["@dcloudio/types"],
        "skipLibCheck": true,
        "noImplicitThis": false
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "vite.config.ts"]
}
