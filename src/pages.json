            "style": {
                "navigationBarTitleText": "模板",
                "navigationStyle": "custom"
            }
        },
        {
            "path": "pages/example/about",
            "style": {
                "navigationBarTitleText": "关于",
                "navigationStyle": "custom"
            }
        }
    ],
