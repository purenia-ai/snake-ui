        "test:docs-homepage": "node --test tests/docs-homepage.test.mjs",
        "test:component-contracts": "node --test tests/component-contracts.test.mjs",
        "test:structure": "node --test tests/package-structure.test.mjs",
        "test:cms": "node --test tests/cms.test.mjs",
        "test:demo-tabbar": "node --test tests/demo-tabbar.test.mjs",
        "test:release": "pnpm lint && pnpm type-check && pnpm test:all && pnpm docs:build",
